# Copy this file to .env and update the values before going live.
# These values are used by both local Node runs and Docker.

PORT=3000
NODE_ENV=production
ADMIN_USER=eventadmin
ADMIN_PASS=ChangeMeStrongPassword!

# PostgreSQL connection for running the Node app outside Docker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance
DB_USER=attendance
DB_PASSWORD=ChangeThisDatabasePassword
# For a hosted database, use DATABASE_URL instead of DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# PostgreSQL container settings for Docker Compose.
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=ChangeThisDatabasePassword
POSTGRES_PORT=5432
